{
  "name": "paper-radio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PDF를 원본 그대로 보면서 온디바이스 TTS로 듣는 웹앱 — 보기(고정 레이아웃)와 읽기(문장 청크)를 오프셋으로 잇는다",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:speak": "node --experimental-strip-types src/lib/refine/speak.check.ts"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^1.3.0"
  },
  "dependencies": {
    "idb": "^8.0.1",
    "onnxruntime-web": "^1.27.0",
    "pdfjs-dist": "^6.2.108"
  }
}
